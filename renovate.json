{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>StackVista/renovate-config#005e342f15c5481932542b5552b23cdd21e624a9",
    "github>StackVista/renovate-config:go#005e342f15c5481932542b5552b23cdd21e624a9",
    "github>StackVista/renovate-config:docker#005e342f15c5481932542b5552b23cdd21e624a9",
    "github>StackVista/renovate-config:automerge#005e342f15c5481932542b5552b23cdd21e624a9"
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "/datadog/i",
        "github.com/StackVista/sketches-go"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "(?<depName>(?:quay\\.io/stackstate/datadog_build_(?:system-probe|deb)_(?:x64|arm64)|registry\\.suse\\.com/bci/bci-micro)):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
