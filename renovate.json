{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>StackVista/renovate-config#v1.1.0",
    "github>StackVista/renovate-config:go#v1.1.0",
    "github>StackVista/renovate-config:docker#v1.1.0",
    "github>StackVista/renovate-config:automerge#v1.1.0"
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "/datadog/i",
        "github.com/StackVista/sketches-go"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "renovate-config",
        "github-actions"
      ],
      "matchPackageNames": [
        "StackVista/renovate-config"
      ],
      "groupName": "Renovate configuration",
      "groupSlug": "renovate-config",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "(?<depName>(?:quay\\.io/stackstate/datadog_build_(?:system-probe|deb)_(?:x64|arm64)|registry\\.suse\\.com/bci/bci-micro)):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
